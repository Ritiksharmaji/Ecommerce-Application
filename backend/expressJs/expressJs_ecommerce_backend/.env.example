# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# MongoDB connection string (give this backend its own database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# JWT auth
JWT_SECRET=<long-random-string>
JWT_EXPIRE=7d

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Stripe (optional - payments routes are disabled when STRIPE_SECRET_KEY is empty)
STRIPE_SECRET_KEY=sk_test_<...>
STRIPE_WEBHOOK_SECRET=whsec_<...>

# Admin account created/promoted on server start
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-password>

# Websites allowed to call the API (comma separated). Leave empty in development to allow all.
# Production example: CORS_ORIGINS=https://shopvra.space,https://www.shopvra.space
CORS_ORIGINS=
