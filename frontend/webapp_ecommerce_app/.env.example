# Backend URL (no trailing /api). Optional - the defaults are:
#   npm run dev   -> http://localhost:3000        (set in .env.development)
#   npm run build -> https://api.shopvra.space    (deployed backend on AWS Lambda)
# Set VITE_BACKEND_URL in .env.development or .env.production only to override them.
VITE_BACKEND_URL=http://localhost:3000
