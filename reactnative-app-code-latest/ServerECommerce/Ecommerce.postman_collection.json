{
  "info": {
    "name": "Ecommerce API (MongoDB + JWT)",
    "_postman_id": "b1e7c2a0-9f3d-4c1a-8e2b-ecommerceapi001",
    "description": "Full REST API collection for the Ecommerce React Native backend (Express + MongoDB + JWT auth).\n\n## Setup\n1. Select an environment (or use the collection variables `baseUrl` and `token`).\n2. Run **Auth > Login** (or **Register**). The test script automatically stores the returned JWT into the `token` collection variable.\n3. All protected requests use `Authorization: Bearer {{token}}` via the collection-level auth, so you do not need to paste the token manually.\n\n## Notes\n- `{{baseUrl}}` defaults to `http://localhost:3000/api`.\n- Admin-only routes require a user with `role: admin` (set via ADMIN_EMAIL / ADMIN_PASSWORD on the server).\n- Product create/update use `multipart/form-data` (image file upload via Cloudinary).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token saved from Register');",
                  "}",
                  "pm.test('Status is 201', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a new user. Returns `{ success, token, user }`. No auth required."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token saved from Login');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate. Returns `{ success, token, user }`. The test script saves the token automatically. No auth required."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Return the currently authenticated user. Requires Bearer token."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "List active products (paginated). Public."
          }
        },
        {
          "name": "Get Single Product",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Get a product by id. Public."
          }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Classic T-Shirt", "type": "text" },
                { "key": "description", "value": "A comfortable cotton t-shirt", "type": "text" },
                { "key": "price", "value": "29.99", "type": "text" },
                { "key": "category", "value": "Men", "type": "text" },
                { "key": "stock", "value": "100", "type": "text" },
                { "key": "sizes", "value": "S,M,L,XL", "type": "text" },
                { "key": "images", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Create a product (admin only). Uses multipart/form-data. Attach 1-5 files under the `images` key (uploaded to Cloudinary). `sizes` may be a comma-separated string or JSON array. At least one image is required."
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated T-Shirt", "type": "text" },
                { "key": "price", "value": "24.99", "type": "text" },
                { "key": "stock", "value": "80", "type": "text" },
                { "key": "sizes", "value": "M,L,XL", "type": "text" },
                { "key": "existingImages", "value": "https://res.cloudinary.com/.../old.jpg", "type": "text", "description": "Repeat this key for each image you want to keep" },
                { "key": "images", "type": "file", "src": [], "description": "Optional: new image files to append" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Update a product (admin only). multipart/form-data. Provide `existingImages` (repeatable) for images to retain, and optionally new `images` files to append."
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Delete a product and its Cloudinary images (admin only)."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            },
            "description": "Get the authenticated user's cart (created empty if none exists)."
          }
        },
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1,\n  \"size\": \"M\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/add",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "add"]
            },
            "description": "Add an item to the cart. Validates stock."
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3,\n  \"size\": \"M\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/item/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "item", "{{productId}}"]
            },
            "description": "Update quantity for a product+size in the cart. Set quantity <= 0 to remove. `size` in body identifies the line item."
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/item/{{productId}}?size=M",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "item", "{{productId}}"],
              "query": [{ "key": "size", "value": "M" }]
            },
            "description": "Remove a specific product+size line from the cart. NOTE: `size` is passed as a QUERY param, not in the body."
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            },
            "description": "Empty the cart."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "List the authenticated user's orders (newest first)."
          }
        },
        {
          "name": "Get Single Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Get one order by id. Owner or admin only."
          }
        },
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.data && res.data._id) {",
                  "  pm.collectionVariables.set('orderId', res.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"type\": \"home\",\n    \"street\": \"123 Main St\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zipCode\": \"10001\",\n    \"country\": \"USA\"\n  },\n  \"paymentMethod\": \"cash\",\n  \"notes\": \"Leave at the door\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Create an order from the current cart. Verifies stock, reduces stock, and (for non-stripe payment) clears the cart. `paymentMethod` can be `cash` or `stripe`."
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderStatus\": \"shipped\",\n  \"paymentStatus\": \"paid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            },
            "description": "Update order/payment status (admin only). Setting orderStatus to `delivered` stamps deliveredAt."
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/admin/all?page=1&limit=20&status=",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "admin", "all"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "", "description": "Optional orderStatus filter (e.g. pending, shipped, delivered)" }
              ]
            },
            "description": "List all orders across users (admin only), paginated."
          }
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "Get Addresses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["addresses"]
            },
            "description": "List the user's saved addresses (default first)."
          }
        },
        {
          "name": "Add Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.data && res.data._id) {",
                  "  pm.collectionVariables.set('addressId', res.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"home\",\n  \"street\": \"123 Main St\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"zipCode\": \"10001\",\n  \"country\": \"USA\",\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["addresses"]
            },
            "description": "Create a new address. If `isDefault` is true, all other addresses are unset as default."
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"work\",\n  \"street\": \"456 Office Blvd\",\n  \"city\": \"Boston\",\n  \"state\": \"MA\",\n  \"zipCode\": \"02101\",\n  \"country\": \"USA\",\n  \"isDefault\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["addresses", "{{addressId}}"]
            },
            "description": "Update an address. Owner only."
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["addresses", "{{addressId}}"]
            },
            "description": "Delete an address. Owner only."
          }
        }
      ]
    },
    {
      "name": "Wishlist",
      "item": [
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist"]
            },
            "description": "Get the user's wishlist products."
          }
        },
        {
          "name": "Toggle Wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wishlist/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "toggle"]
            },
            "description": "Add the product if not present, otherwise remove it."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats"]
            },
            "description": "Dashboard totals and recent orders (admin only)."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product\": {\n        \"name\": \"Classic T-Shirt\",\n        \"images\": [\"https://res.cloudinary.com/.../shirt.jpg\"]\n      },\n      \"price\": 29.99,\n      \"quantity\": 2\n    }\n  ],\n  \"shipping\": 2,\n  \"orderId\": \"{{orderId}}\",\n  \"success_url\": \"https://success.com\",\n  \"cancel_url\": \"https://cancel.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/checkout-session",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "checkout-session"]
            },
            "description": "Create a Stripe Checkout session. Returns `{ id, url }`. Only mounted when STRIPE_SECRET_KEY is configured on the server."
          }
        }
      ]
    }
  ]
}
