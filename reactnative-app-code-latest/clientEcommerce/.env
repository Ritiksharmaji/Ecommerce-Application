# Base URL of the ServerECommerce backend (Express + MongoDB), default PORT 3000.
# Use your PC's LAN IP so the phone (Expo Go) can reach it. Phone + PC on same WiFi.
# Find it with `ipconfig getifaddr en0` (Mac) or `ipconfig` (Windows). Restart Expo after changing (npx expo start -c).
# IMPORTANT: do NOT include a trailing /api here. Endpoints already include /api/... in code.
# After deploying the backend, replace this with the deployed URL, e.g. https://your-backend.vercel.app
EXPO_PUBLIC_API_URL=http://192.168.128.96:3000

# Old web backend (forever-full-stack) - no longer used by this app:
# EXPO_PUBLIC_API_URL=https://ecommerce-backend-expressjs-code-complete.onrender.com
